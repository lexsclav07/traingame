class_name TX
## Texture and PBR material helpers (textures live in assets/textures and are
## generated by tools/gen_textures.py).

static var _tex := {}
static var _mats := {}


static func t(name: String) -> Texture2D:
	if _tex.has(name):
		return _tex[name]
	var tex: Texture2D = null
	for ext in [".jpg", ".png"]:
		var path: String = "res://assets/textures/" + name + ext
		if ResourceLoader.exists(path):
			tex = load(path)
			break
	if tex == null:
		push_warning("missing texture " + name)
	_tex[name] = tex
	return tex


## PBR material. 'scale' is texture repeats per metre (triplanar, object space
## unless world = true). Pass "" for normal to skip it.
static func pbr(albedo: String, normal := "", tint := Color.WHITE, rough := 0.85, metal := 0.0,
		scale := Vector3.ONE, world := false, normal_strength := 1.0, key := "") -> StandardMaterial3D:
	var k := key if key != "" else "%s|%s|%s|%.2f|%.2f|%s|%s|%.2f" % [albedo, normal, tint.to_html(), rough, metal, str(scale), str(world), normal_strength]
	if _mats.has(k):
		return _mats[k]
	var m := StandardMaterial3D.new()
	if albedo != "":
		m.albedo_texture = t(albedo)
	m.albedo_color = tint
	m.roughness = rough
	m.metallic = metal
	if normal != "":
		m.normal_enabled = true
		m.normal_texture = t(normal)
		m.normal_scale = normal_strength
	m.uv1_triplanar = true
	m.uv1_world_triplanar = world
	m.uv1_scale = scale
	m.uv1_triplanar_sharpness = 4.0
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	if tint.a < 0.999:
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	_mats[k] = m
	return m


## Painted / plain surface with a greyscale weathering multiply (grime / paint_wear).
static func painted(col: Color, rough := 0.45, metal := 0.1, wear := "grime", scale := 0.35, clearcoat := 0.0, key := "") -> StandardMaterial3D:
	var k := key if key != "" else "paint|%s|%.2f|%.2f|%s|%.2f|%.2f" % [col.to_html(), rough, metal, wear, scale, clearcoat]
	if _mats.has(k):
		return _mats[k]
	var m := StandardMaterial3D.new()
	m.albedo_color = col
	if wear != "":
		m.albedo_texture = t(wear)
		m.uv1_triplanar = true
		m.uv1_scale = Vector3.ONE * scale
		m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	m.roughness = rough
	m.metallic = metal
	if clearcoat > 0.0:
		m.clearcoat_enabled = true
		m.clearcoat = clearcoat
		m.clearcoat_roughness = 0.15
	_mats[k] = m
	return m


## Moulded plastic / powder-coated panel with a fine stipple.
static func plastic(col: Color, rough := 0.6, scale := 6.0, key := "") -> StandardMaterial3D:
	var k := key if key != "" else "plastic|%s|%.2f|%.2f" % [col.to_html(), rough, scale]
	if _mats.has(k):
		return _mats[k]
	var m := StandardMaterial3D.new()
	m.albedo_color = col
	m.roughness = rough
	# interiors: keep the sky out of the reflections (no reflection probes)
	m.metallic_specular = 0.25
	m.normal_enabled = true
	m.normal_texture = t("plastic_normal")
	m.normal_scale = 0.5
	m.uv1_triplanar = true
	m.uv1_scale = Vector3.ONE * scale
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	_mats[k] = m
	return m


## Brushed metal: stainless steel bodies, polished rail heads, brass.
static func metal(col: Color, rough := 0.3, brushed := true, scale := 2.0, key := "") -> StandardMaterial3D:
	var k := key if key != "" else "metal|%s|%.2f|%s|%.2f" % [col.to_html(), rough, str(brushed), scale]
	if _mats.has(k):
		return _mats[k]
	var m := StandardMaterial3D.new()
	m.albedo_color = col
	m.metallic = 1.0
	m.roughness = rough
	if brushed:
		m.normal_enabled = true
		m.normal_texture = t("brushed_normal")
		m.normal_scale = 0.6
		m.uv1_triplanar = true
		m.uv1_scale = Vector3.ONE * scale
		m.anisotropy_enabled = true
		m.anisotropy = 0.4
	_mats[k] = m
	return m


## UV-mapped PBR material for geometry whose UVs are laid out in metres
## ('tile' = metres per texture repeat). Use for roofs, paving, windows.
static func uv(albedo: String, normal := "", tint := Color.WHITE, rough := 0.85, metal := 0.0,
		tile := Vector2.ONE, normal_strength := 1.0, key := "") -> StandardMaterial3D:
	var k := key if key != "" else "uv|%s|%s|%s|%.2f|%.2f|%s|%.2f" % [albedo, normal, tint.to_html(), rough, metal, str(tile), normal_strength]
	if _mats.has(k):
		return _mats[k]
	var m := StandardMaterial3D.new()
	if albedo != "":
		m.albedo_texture = t(albedo)
	m.albedo_color = tint
	m.roughness = rough
	m.metallic = metal
	if normal != "":
		m.normal_enabled = true
		m.normal_texture = t(normal)
		m.normal_scale = normal_strength
	m.uv1_scale = Vector3(1.0 / tile.x, 1.0 / tile.y, 1.0)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	_mats[k] = m
	return m


## Alpha-tested cut-out, drawn double sided: fences, valances, fence wire.
static func cutout(albedo: String, tint := Color.WHITE, rough := 0.7, metal := 0.0, tile := Vector2.ONE, key := "") -> StandardMaterial3D:
	var k := key if key != "" else "cut|%s|%s|%.2f|%.2f|%s" % [albedo, tint.to_html(), rough, metal, str(tile)]
	if _mats.has(k):
		return _mats[k]
	var m := uv(albedo, "", tint, rough, metal, tile, 1.0, k + "_base").duplicate() as StandardMaterial3D
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	m.alpha_scissor_threshold = 0.5
	m.alpha_antialiasing_mode = BaseMaterial3D.ALPHA_ANTIALIASING_ALPHA_TO_COVERAGE
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	_mats[k] = m
	return m


static func shader_mat(path: String) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = load(path)
	return m
